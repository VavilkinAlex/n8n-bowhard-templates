            {
              "id": "col-text",
              "name": "text",
              "value": "={{ 'НОВАЯ ЗАЯВКА\\nКанал: ' + $('Нормализация заявки').item.json.channel + '\\nИмя: ' + $('Нормализация заявки').item.json.name + '\\nКонтакт: ' + $('Нормализация заявки').item.json.contact + '\\nКомпания: ' + $('Нормализация заявки').item.json.company + '\\nСтраница: ' + $('Нормализация заявки').item.json.page + '\\nТекст обращения: ' + $('Нормализация заявки').item.json.message + '\\n\\nДАННЫЕ ИЗ ВЛОЖЕНИЯ:\\n' + ($json.choices ? $json.choices[0].message.content : 'вложения нет') }}",
