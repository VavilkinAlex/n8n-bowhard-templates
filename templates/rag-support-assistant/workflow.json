    {
      "id": "ef04bc83-c300-4219-b033-556eeb7787af",
      "name": "Собрать промпт с базой знаний",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        112
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "rag-question",
              "name": "question",
              "value": "={{ $json.body.question || \"Как с вами связаться?\" }}",
              "type": "string"
            },
            {
              "id": "rag-prompt",
              "name": "prompt",
              "value": "={{ \"Ты — ассистент службы поддержки компании. Отвечай только по базе знаний, коротко и вежливо. Если ответа в базе нет — предложи передать вопрос менеджеру.\\n\\nБАЗА ЗНАНИЙ:\\n1. Доставка по Москве — 1-2 дня, по России — 3-7 дней. Курьер бесплатно от 5 000 ₽.\\n2. Оплата: карта, СБП, счёт для юрлиц. Предоплата 50% для юрлиц.\\n3. Возврат в течение 14 дней, если товар не вскрыт.\\n4. Гарантия на продукцию 12 месяцев, сервис — по адресу склада.\\n5. Связаться с менеджером: чат на сайте или почта support@example.ru.\\n\\nВОПРОС КЛИЕНТА: \" + $json.body.question }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "563c8838-c077-4e03-82bf-d30d397f6159",
      "name": "Ответ по базе знаний",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}"
      }
    },
    {
      "id": "c851f737-6881-4602-94a3-cfaccb2a55ad",
      "name": "GPT-модель",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        528,
        336
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "7dee2734-45c8-4841-a2fc-fc64267cb20c",
      "name": "Ответ: ответ ассистента",
