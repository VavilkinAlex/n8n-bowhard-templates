{
  "name": "Яндекс Календарь: создать событие",
  "nodes": [
    {
      "id": "04363673-5e7a-44a8-bc1c-3176a970a2fb",
      "name": "Запрос события",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "yandex-event-create",
        "responseMode": "lastNode",
        "responseData": "allEntries",
        "options": {
          "onlyRunIf": "={{ $json.headers['x-watchdog-token'] === 'REPLACE_WITH_YOUR_TOKEN' }}"
        }
      }
    },
    {
      "id": "79d3cfbf-5902-4432-89cd-aec7dedb81bd",
      "name": "Собрать событие",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "iCal",
        "title": "={{ $json.body.title }}",
        "start": "={{ $json.body.start }}",
        "end": "={{ $json.body.end }}",
        "allDay": "={{ $json.body.allDay }}",
        "additionalFields": {
          "uid": "={{ $json.body.uid }}",
          "description": "={{ $json.body.description || \"\" }}",
          "fileName": "={{ $json.body.uid + '.ics' }}"
        }
      }
    },
    {
      "id": "4527b754-a780-403b-ac55-774fea40ee60",
      "name": "Положить в календарь",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://caldav.yandex.ru' + $('Запрос события').first().json.body.calendarPath + $('Запрос события').first().json.body.uid + '.ics' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "941c65e7-b491-4868-8d81-eda949dd8425",
      "name": "Итог",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const request = ($('Запрос события').first().json.body) || {};\nconst response = $json || {};\nconst status = Number(response.statusCode || 0);\n\nconst note = status === 201 ? 'событие создано'\n  : (status === 204 ? 'событие обновлено'\n  : (status === 401 ? 'отказ в доступе — проверить учётные данные'\n  : (status === 403 ? 'календарь только для чтения' : ('код ' + status))));\n\nreturn [{ json: {\n  title: String(request.title || ''),\n  start: String(request.start || ''),\n  end: String(request.end || ''),\n  allDay: request.allDay === true,\n  status: status,\n  ok: status === 201 || status === 204,\n  note: note\n} }];"
      }
    }
  ],
  "connections": {
    "Запрос события": {
      "main": [
        [
          {
            "node": "Собрать событие",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Собрать событие": {
      "main": [
        [
          {
            "node": "Положить в календарь",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Положить в календарь": {
      "main": [
        [
          {
            "node": "Итог",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  }
}
