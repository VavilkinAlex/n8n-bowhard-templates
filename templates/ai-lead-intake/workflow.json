      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').item.json.llm_base_url }}/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Настройки').item.json.llm_model, messages: [ { role: 'user', content: [ { type: 'text', text: 'Извлеки из документа данные заявки: ФИО, телефон, email, что нужно сделать, бюджет, срок. Кратким списком, без выдумок. Если поля нет — напиши нет данных.' }, { type: 'image_url', image_url: { url: $json.attachment_url } } ] } ] } }}",
        "options": {
          "response": {
            "responseFormat": "json"
          },
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
