    {
      "id": "6e6592de-1cc3-4349-853e-e04c8a58c081",
      "name": "Пинг менеджеру",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2240,
        80
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Настройки').item.json.manager_chat_id }}",
        "text": "={{ '🔔 НОВАЯ ЗАЯВКА ' + $('Карточка заявки').item.json.lead_id + '\\nКанал: ' + $('Карточка заявки').item.json.channel + '\\nКлиент: ' + $('Карточка заявки').item.json.name + ' (' + $('Карточка заявки').item.json.contact + ')\\nКатегория: ' + $('Карточка заявки').item.json.category + ' · Приоритет: ' + $('Карточка заявки').item.json.priority + '\\nСуть: ' + $('Карточка заявки').item.json.summary + '\\nНе хватает: ' + ($('Карточка заявки').item.json.missing || '—') + '\\n\\nЧерновик ответа:\\n' + $('Карточка заявки').item.json.draft_reply }}",
        "additionalFields": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "188b1fbd-a410-463b-9a5b-9f0368a2c936",
      "name": "Ответ каналу",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2464,
        80
