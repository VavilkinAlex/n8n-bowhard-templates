      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, lead_id: $('Карточка заявки').item.json.lead_id, category: $('Карточка заявки').item.json.category, priority: $('Карточка заявки').item.json.priority, draft_reply: $('Карточка заявки').item.json.draft_reply, needs_human: $('Карточка заявки').item.json.needs_human } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
