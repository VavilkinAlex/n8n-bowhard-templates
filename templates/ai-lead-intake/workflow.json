      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').item.json.llm_base_url }}/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Настройки').item.json.llm_model, messages: [ { role: 'system', content: 'Ты — приёмщик заявок в студии автоматизации. Отвечай строго одним JSON-объектом без пояснений и без markdown. Поля: category (одно из: консультация, заказ, документы, жалоба, партнёрство), priority (высокий, средний или низкий), summary (1-2 предложения), what_needed (что нужно клиенту), missing (каких данных не хватает), draft_reply (вежливый черновик ответа клиенту от 3 до 5 предложений с уточняющим вопросом), needs_human (true или false).' }, { role: 'user', content: $json.text } ] } }}",
        "options": {
          "response": {
            "responseFormat": "json"
          },
          "timeout": 90000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "id": "827c8623-3cd5-49a5-875f-75931f8e795d",
      "name": "Карточка заявки",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const lead = $('Собрать текст заявки').first().json;\nconst raw = $input.first().json;\nconst content = raw && raw.choices && raw.choices[0] && raw.choices[0].message ? raw.choices[0].message.content : '';\nlet d = {};\ntry {\n  const m = String(content).match(/\\{[\\s\\S]*\\}/);\n  d = JSON.parse(m ? m[0] : content);\n} catch (e) {\n  d = { category: 'не разобрано', priority: 'средний', summary: String(content), what_needed: '', missing: '', draft_reply: '', needs_human: true };\n}\nreturn [{ json: { lead_id: lead.lead_id, received_at: lead.received_at, channel: lead.channel, name: lead.name, contact: lead.contact, company: lead.company, page: lead.page, attachment_url: lead.attachment_url, category: d.category || 'не разобрано', priority: d.priority || 'средний', summary: d.summary || '', what_needed: d.what_needed || '', missing: d.missing || '', draft_reply: d.draft_reply || '', needs_human: d.needs_human === true } }];"
      }
    },
    {
      "id": "5269bdd8-2688-4729-a7c5-f44ad0fff2e4",
      "name": "Записать в CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
